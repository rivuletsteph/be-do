{
  "permissions": {
    "allow": [
      "mcp__Gmail__unlabel_thread",
      "mcp__Gmail__label_thread",
      "mcp__Google_Drive__trash_file"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "git -C \"$CLAUDE_PROJECT_DIR\" config core.hooksPath .githooks"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "mcp__github__(create_pull_request|update_pull_request|add_issue_comment|update_issue_comment|issue_write|add_reply_to_pull_request_comment|add_comment_to_pending_review|pull_request_review_write|create_branch|push_files|create_or_update_file)",
        "hooks": [
          {
            "type": "command",
            "command": "PYTHONUTF8=1 python3 \"$CLAUDE_PROJECT_DIR/tools/privacy_hook.py\""
          }
        ]
      }
    ]
  }
}
